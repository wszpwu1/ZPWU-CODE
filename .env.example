# ── 服务器监听地址 ──────────────────────────────────────
APP_ADDR=:8080

# ── 接口访问令牌（可选）────────────────────────────────
# 若设置，所有 /api/* 接口需携带 X-App-Token: <此值>
# 留空则无需该令牌（GitHub Token 本身即作为权限校验）
APP_ACCESS_TOKEN=

# ── GitHub OAuth 应用凭证 ──────────────────────────────
# 在 https://github.com/settings/developers 创建 OAuth App
# Callback URL 填写: https://<your-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── 对外访问基址（反向代理 / 公网部署强烈建议设置）──────
# 用于拼接 OAuth redirect_uri，避免被伪造的 Host 头篡改回调地址。
# 填写用户实际访问的完整地址（不含末尾斜杠），例如：
#   APP_PUBLIC_URL=https://code.example.com
# 留空则回退到从请求 Host 头推导（仅适合本地开发）。
APP_PUBLIC_URL=

# ── LLM 端点 SSRF 严格模式 ─────────────────────────────
# 默认关闭：允许用户把模型 base_url 指向本地/内网推理网关
#（如 http://localhost:11434/v1 的 Ollama）。云元数据地址
#（169.254.0.0/16、fe80::/10、metadata.google.internal 等）始终拦截。
# 设为 1 后额外拦截回环与私网地址（127.0.0.0/8、10/8、172.16/12、
# 192.168/16、fc00::/7），并对主机名做 DNS 解析校验——适合多租户公网部署。
SSRF_STRICT=

# ── 草稿箱持久化（可选）────────────────────────────────
# 默认草稿仅存内存，进程重启即丢失。设置为一个 JSON 文件路径可让草稿
# 跨重启保留（save/update/delete 时原子落盘，权限 0600）。
# 注意：草稿内含 GitHub 明文内容，请确保该文件所在目录安全。
#   DRAFTS_FILE=./data/drafts.json
DRAFTS_FILE=


# ── 说明 ───────────────────────────────────────────────
# 本项目默认为无状态服务器设计：
#   - API Key 仅存于用户浏览器 localStorage，不经过服务器持久化
#   - GitHub Token 通过 OAuth 流程获取后直接存于浏览器
#   - 草稿箱默认也只在内存中，进程重启即丢失
#   - 1核1G 的 Linux 服务器即可运行（Go 静态二进制 + 前端静态文件）
#
# 可选：设置 DRAFTS_FILE 后，草稿会原子化写入该 JSON 文件（权限 0600），
#       跨进程重启保留。这是唯一会写盘的路径，其他业务数据仍不落盘。
#
# 启动方式:
#   go run ./cmd/server
#   或编译后运行:
#   go build -o zpwu ./cmd/server && ./zpwu
